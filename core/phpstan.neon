includes:
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        # Generated by the Symfony recipe, not ours to keep clean.
        - tests/bootstrap.php
    symfony:
        # The test container, not the dev one: `tests/` is in the analysed paths,
        # and functional tests resolve services through the test container, which
        # exposes private services the dev container hides. Pointing at dev makes
        # PHPStan claim that services the tests genuinely resolve do not exist.
        # Regenerated by running the test suite once.
        containerXmlPath: var/cache/test/App_KernelTestDebugContainer.xml
